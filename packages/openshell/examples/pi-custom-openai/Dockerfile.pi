FROM node:24-bookworm-slim

ARG PI_VERSION=latest

RUN apt-get update \
    && apt-get install -y --no-install-recommends bash ca-certificates fd-find git ripgrep \
    && ln -s /usr/bin/fdfind /usr/local/bin/fd \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g --ignore-scripts "@earendil-works/pi-coding-agent@${PI_VERSION}"

# OpenShell runs sandbox processes as 10001:10001. Keep the image account in
# sync so the runtime UID has a passwd entry and can write to its workspace.
RUN groupmod --gid 10001 node \
    && usermod --uid 10001 --gid 10001 node \
    && mkdir -p /workspace \
    && chown node:node /workspace

COPY --chown=node:node pi-custom-openai /usr/local/bin/pi-custom-openai

USER node
WORKDIR /workspace
