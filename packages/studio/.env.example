BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ISSUER=https://auth.mizuumi.test/realms/sovico
UNITYCATALOG_URL=https://unitycatalog.mizuumi.test
DAGSTER_GRAPHQL_URL=https://api.dagster.mizuumi.test/graphql
CONTROLPLANE_URL=https://api.controlplane.mizuumi.test
DUCK_QUERY_URL=https://query.mizuumi.test/api/query

# Pi/OpenShell settings. Studio reads base_url from this KV v2 secret.
# Authenticate the Vault CLI before starting Studio; the API key remains in the
# OpenShell provider and is never returned to the browser.
OPENSHELL_OIDC_ISSUER=https://auth.mizuumi.test/realms/sovico
OPENSHELL_OIDC_CLIENT_ID=studio
OPENSHELL_OIDC_CLIENT_SECRET=
OPENSHELL_OIDC_AUDIENCE=openshell-cli
OPENSHELL_PI_IMAGE=pi-custom-openai:local-1
OPENSHELL_PI_PROVIDER=pi-custom-openai
# OpenShell provider that whitelists egress to the Mizuumi MCP endpoint.
OPENSHELL_MCP_PROVIDER=mizuumi-mcp
# Streamable-HTTP MCP endpoint exposed to each pi sandbox as the "mizuumi" server.
# Default uses the in-cluster service to bypass Caddy's private CA (the OpenShell
# supervisor only trusts public roots). Override to https://mcp.mizuumi.test/mcp
# only after wiring upstreamProxy.caBundle in the OpenShell Helm values.
MIZUUMI_MCP_URL=http://mcp.mcp.svc.cluster.local:8080/mcp
VAULT_ADDR=https://vault.mizuumi.test
VAULT_CACERT=../../k8s/auth/tls/ca.crt
VAULT_KV_MOUNT=pi-custom-openai
VAULT_KV_SECRET_PATH=config
