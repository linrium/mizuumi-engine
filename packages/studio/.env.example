BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ISSUER=https://auth.mizuumi.test/realms/sovico
UNITYCATALOG_URL=https://unitycatalog.mizuumi.test
QUACK_URI=quack:query.mizuumi.test:443
QUACK_TOKEN=
QUACK_CA_FILE=../../k8s/auth/tls/ca.crt

# Pi/OpenShell settings. Studio reads base_url from this KV v2 secret.
# Authenticate the Vault CLI before starting Studio; the API key remains in the
# OpenShell provider and is never returned to the browser.
OPENSHELL_OIDC_ISSUER=https://auth.mizuumi.test/realms/sovico
OPENSHELL_OIDC_CLIENT_ID=studio
OPENSHELL_OIDC_CLIENT_SECRET=
OPENSHELL_OIDC_AUDIENCE=openshell-cli
OPENSHELL_PI_IMAGE=pi-custom-openai:local-1
OPENSHELL_PI_PROVIDER=pi-custom-openai
VAULT_ADDR=https://vault.mizuumi.test
VAULT_CACERT=../../k8s/auth/tls/ca.crt
VAULT_KV_MOUNT=pi-custom-openai
VAULT_KV_SECRET_PATH=config
