[req]
distinguished_name = dn
x509_extensions = ext
prompt = no

[dn]
CN = keycloak.auth.svc.cluster.local

[ext]
basicConstraints = critical,CA:FALSE
keyUsage = critical,digitalSignature,keyEncipherment
extendedKeyUsage = serverAuth
subjectAltName = @san

[san]
DNS.1 = keycloak.auth.svc.cluster.local
DNS.2 = keycloak.auth.svc
DNS.3 = keycloak
DNS.4 = localhost
DNS.5 = auth.localhost
IP.1 = 127.0.0.1
