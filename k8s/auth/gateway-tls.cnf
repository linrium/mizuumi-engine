[req]
distinguished_name = dn
x509_extensions = ext
prompt = no

[dn]
CN = auth.mizuumi.test

[ext]
basicConstraints = critical,CA:FALSE
keyUsage = critical,digitalSignature,keyEncipherment
extendedKeyUsage = serverAuth
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid:always
subjectAltName = @san

[san]
DNS.1 = auth.mizuumi.test
DNS.2 = vault.mizuumi.test
DNS.3 = storage.mizuumi.test
DNS.4 = api.storage.mizuumi.test
DNS.5 = unitycatalog.mizuumi.test
DNS.6 = openshell.mizuumi.test
DNS.7 = api.redpanda.mizuumi.test
DNS.8 = console.redpanda.mizuumi.test
DNS.9 = console.signoz.mizuumi.test
DNS.10 = otlp.signoz.mizuumi.test
DNS.11 = api.chronicle.mizuumi.test
DNS.12 = ui.chronicle.mizuumi.test
DNS.13 = query.mizuumi.test
DNS.14 = mcp.mizuumi.test
DNS.15 = localhost
IP.1 = 127.0.0.1
