[req]
distinguished_name = dn
x509_extensions = ext
prompt = no

[dn]
CN = rustfs-svc.rustfs.svc.cluster.local

[ext]
basicConstraints = critical,CA:FALSE
keyUsage = critical,digitalSignature,keyEncipherment
extendedKeyUsage = serverAuth
subjectAltName = @san

[san]
DNS.1 = rustfs-svc.rustfs.svc.cluster.local
DNS.2 = rustfs-svc.rustfs.svc
DNS.3 = rustfs-svc
DNS.4 = localhost
DNS.5 = storage.localhost
DNS.6 = storage-console.localhost
IP.1 = 127.0.0.1
